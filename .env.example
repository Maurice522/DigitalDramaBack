MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net"

# Fallback chain, tried in this order — every key is used live now that the
# automation pipeline no longer pre-generates audio at creation time.
CARTESIA_LIVE_API_KEY=
CARTESIA_API_KEY=
CARTESIA_API_KEY_2=
CARTESIA_API_KEY_3=
CARTESIA_API_KEY_4=
CARTESIA_BACKUP_API_KEY=
CARTESIA_BACKUP_API_KEY_2=
CARTESIA_BACKUP_API_KEY_3=

# Comma-separated list of origins allowed to call this API, e.g.
# https://digitaldrama.pages.dev,https://digitaldrama.com
# Defaults to "*" (any origin) until the real frontend domain is known.
ALLOWED_ORIGIN=*
